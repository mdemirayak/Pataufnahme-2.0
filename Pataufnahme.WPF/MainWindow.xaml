<Window x:Class="Pataufnahme.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pataufnahme.WPF"
        xmlns:Views="clr-namespace:Pataufnahme.WPF.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="850" Width="750" MaxWidth="1250"
        WindowState="Normal"
        Background="#CCFFCC" 
    >

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid>

            <Views:Patinfo DataContext="{Binding Content}"/>
            <TextBlock  Height="18" FontSize="15" TextAlignment="Left" VerticalAlignment="Bottom" Text="Status:" Background="LightGray"  />
        </Grid>
    </ScrollViewer>
</Window>
