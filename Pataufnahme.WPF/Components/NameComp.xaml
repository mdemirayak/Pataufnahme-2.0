<UserControl x:Class="Pataufnahme.WPF.Components.NameComp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pataufnahme.WPF.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Height="Auto">
        <Grid.RowDefinitions>
            <RowDefinition  Height="auto"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="Name" FontSize="20" Margin="0,0,0,10" />

        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Label  Content="Vorname:" FontSize="12" Margin="0,0,0,5" />
            <Label Content="Nachname:" FontSize="12" Margin="0,0,0,5" />
            <Label Content="Geburtsname:" FontSize="12" Margin="0,0,0,5" />
            <Label Content="Geburtsdatum:" FontSize="12" Margin="0,0,0,5" />
            <Label Content="Geschlecht:" FontSize="12" Margin="0,0,0,5" />
            <Label Content="Anrede:" FontSize="12" Margin="0,0,0,5" />
            <Label Content="Titel:" FontSize="12" Margin="0,0,0,5" />
            <Label Content="Namenszusatz:" FontSize="12" Margin="0,0,0,5" />
            <Label Content="Vorsatzwort:" FontSize="12" Margin="0,0,0,5" />
            <Label Content="Staatsangehörigkeit:" FontSize="12" Margin="0,0,0,5" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBox Style="{StaticResource YellowTextBox}"  Text="{Binding Vorname}" Width="350" Margin="0,5,0,5" />
            <Button Width="20" Height="19" Style="{StaticResource CustomButtonWarnung}" Margin="330,-28,0,0" >
                <Image Source="/Styles/warnung.jpg" Stretch="Uniform"/>
            </Button>

            <TextBox Style="{StaticResource YellowTextBox}" Text="{Binding Nachname}" Margin="0,5,0,5" />
            <Button Style="{StaticResource CustomButtonWarnung}" Width="20"  Height="19" Margin="330,-28,0,0">
                
            </Button>
            <TextBox Style="{StaticResource NoBackgroundTextBox}" Text="{Binding Geburtsname}" Margin="0,9,0,5" />
            <StackPanel Orientation="Horizontal">
                <ComboBox Style="{StaticResource ComboBoxRound}" HorizontalAlignment="Left" x:Name="Geburtstag" 
          MinWidth="100" MaxWidth="200" Margin="0,7,0,0" />
                <ComboBox Style="{StaticResource ComboBoxRound}" HorizontalAlignment="Left" x:Name="Geburtsmonat" 
          MinWidth="100" MaxWidth="200" Margin="10,7,0,0" 
          SelectionChanged="Geburtsmonat_SelectionChanged" />
                <ComboBox Style="{StaticResource ComboBoxRound}" HorizontalAlignment="Left" x:Name="Geburtsjahr" 
          MinWidth="100" MaxWidth="200" Margin="10,7,0,0" 
          SelectionChanged="Geburtsjahr_SelectionChanged" />

            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="Mann" Margin="5" Content="Männlich" />
                <RadioButton x:Name="Frau" Margin="5" Content="Weiblich" />
                <RadioButton x:Name="Divers" Margin="5" Content="Divers" />
                <RadioButton x:Name="KA" Margin="5" Content="Keine Angabe" />
            </StackPanel>
            <ComboBox ItemsSource="{Binding Anrede}" Style="{StaticResource ComboBoxRound}" HorizontalAlignment="Left" x:Name="AnredeBox" MinWidth="150" MaxWidth="200" Margin="0,7,0,0">
            </ComboBox>
            <ComboBox ItemsSource="{Binding Titel}" Style="{StaticResource ComboBoxRound}" HorizontalAlignment="Left" x:Name="TitelBox" MinWidth="150" MaxWidth="200" Margin="0,7,0,0">
            </ComboBox>
            <TextBox Style="{StaticResource NoBackgroundTextBox}" Text="hallo" Margin="0,10,0,5" />
            <TextBox Style="{StaticResource NoBackgroundTextBox}" Text="hallo" Margin="0,10,0,5" />
            <Label Content="test" Margin="50,3,0,0" Width="36" />
            <TextBox Style="{StaticResource NoBackgroundTextBox}" Text="hallo" Width="80" Margin="1,-23,100,5" />
        </StackPanel>
    </Grid>
</UserControl>

