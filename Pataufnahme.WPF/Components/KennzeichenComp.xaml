<UserControl x:Class="Pataufnahme.WPF.Components.KennzeichenComp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pataufnahme.WPF.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Height="auto">
        <Grid.RowDefinitions>
            <RowDefinition  Height="auto"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <Label Margin="0,15,0,0" Content="Kennzeichen" Grid.Row="0" Grid.Column="0" FontSize="20" />

        <StackPanel Margin="0,15,0,0" Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left">
            <CheckBox Content="Pförtnersperre" FontSize="12"/>
            <CheckBox Content="Organspender" FontSize="12" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" >
            <TextBox Style="{StaticResource NoBackgroundTextBox}" Margin="0,33,0,0" Text="hallo" Width="350" />
        </StackPanel>
    </Grid>
</UserControl>
