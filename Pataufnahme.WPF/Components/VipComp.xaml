<UserControl x:Class="Pataufnahme.WPF.Components.VipComp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pataufnahme.WPF.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Height="Auto">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Label Content="VIP" Grid.Column="0" Grid.Row="0" FontSize="20"/>

        <StackPanel Grid.Column="0" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Label Margin="0,0,0,0" Content="Bemerkung:" FontSize="12"/>
            <CheckBox x:Name="BemerkungsCheck" Margin="0,0,0,0" Content="Vorschlag" FontSize="12" Checked="BemerkungsCheck_Checked" Unchecked="BemerkungsCheck_Unchecked"/>
            <Label Margin="0,150,0,0" Content="Patientenwünsche:" FontSize="12"/>
            <CheckBox x:Name="PatientenCheck" Margin="0,0,0,0" Content="Vorschlag" FontSize="12" Checked="PatientenCheck_Checked" Unchecked="PatientenCheck_Unchecked"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2">
            <TextBox Opacity="0.15" x:Name="BermerkungsBox" IsEnabled="False" Style="{StaticResource NoBackgroundTextBox}" Margin="0,10,0,0" Text="hallo" Width="350" Height="100"/>
            <TextBox Opacity="0.15" x:Name="PatientenBox" IsEnabled="False" Style="{StaticResource NoBackgroundTextBox}" Margin="10,90,0,0" Text="hallo" Width="350" Height="100"/>
        </StackPanel>
    </Grid>
</UserControl>

